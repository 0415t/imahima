PORT=3000
# 任意: ローカル検証時は HOST=127.0.0.1。未指定時は従来の待受動作。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EXPO_ACCESS_TOKEN=
# 暇状態終了5分前通知ポーラー（true で有効化。デフォルト無効）
FREE_END_NOTIFICATIONS_ENABLED=false
# ポーリング間隔（ミリ秒。デフォルト60000）
FREE_END_NOTIFICATIONS_INTERVAL_MS=60000
# 暇ON時の同じグループの暇メンバーへの通知（DBイベント作成は常時、送信は既定無効）
MEMBER_FREE_NOTIFICATIONS_ENABLED=false
MEMBER_FREE_NOTIFICATIONS_INTERVAL_MS=5000
MEMBER_FREE_NOTIFICATIONS_MAX_ATTEMPTS=3
